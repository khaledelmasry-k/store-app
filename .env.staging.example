# Copy to .env.staging locally; do not commit the copied file.
# Values come from the separate staging Firebase project's Web App config.
VITE_FIREBASE_API_KEY=replace-with-staging-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-staging-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-staging-project
VITE_FIREBASE_STORAGE_BUCKET=replace-with-staging-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-staging-sender-id
VITE_FIREBASE_APP_ID=replace-with-staging-app-id
VITE_FIREBASE_USE_EMULATOR=false
VITE_STORE_BASE_URL=https://staging.example.invalid
