rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Tenant ownership is verified against Firestore: the uploader must be a
    // platform admin OR a store member whose users doc `storeIds` contains the
    // target store. The client-set `metadata.storeId` alone is never trusted —
    // otherwise any signed-in user could write into another store's folder.
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnedByUser(storeId) {
      return isSignedIn() && (
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.storeIds.hasAll([storeId])
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superAdmin'
      );
    }

    function ownsTenant(storeId) {
      return isAdmin() || isOwnedByUser(storeId);
    }

    function uploadedImageOk(storeId) {
      return request.resource.metadata.storeId == storeId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Product images: public read. Uploads require tenant ownership + metadata
    // matching the path store + valid image + size cap. Deletes only need
    // tenant ownership (request.resource is null on delete).
    match /products/{storeId}/{allPaths=**} {
      allow read: if true;
      allow write: if ownsTenant(storeId) && uploadedImageOk(storeId);
      allow delete: if ownsTenant(storeId);
    }

    // Product images created after 2026: `stores/{storeId}/products/{productId}/...`
    // — the product id is generated before upload so each product owns a folder.
    // Same tenant-ownership + image/size guards as the legacy path. This more
    // specific match wins over the generic `stores/{storeId}/{allPaths=**}` rule.
    match /stores/{storeId}/products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if ownsTenant(storeId) && uploadedImageOk(storeId);
      allow delete: if ownsTenant(storeId);
    }

    // Landing page images — public read, same tenant ownership, image + size caps.
    match /landingPages/{storeId}/{allPaths=**} {
      allow read: if true;
      allow write: if ownsTenant(storeId) && uploadedImageOk(storeId);
      allow delete: if ownsTenant(storeId);
    }

    // Store avatars / brand assets — store owner or platform admin only.
    // Writes (upload) require tenant ownership + image content-type + size cap
    // (same guards as product/landing uploads) + a metadata storeId that
    // matches the path-owned tenant.
    match /stores/{storeId}/{allPaths=**} {
      allow read: if true;
      allow write: if ownsTenant(storeId) && uploadedImageOk(storeId);
      allow delete: if ownsTenant(storeId);
    }

    // Merchant uploaded documents (invoices, evidence) — tenant-private: only
    // the owning store's members and the platform admin may read (PII).
    match /documents/{storeId}/{allPaths=**} {
      allow read: if ownsTenant(storeId);
      allow write: if ownsTenant(storeId) && request.resource.metadata.storeId == storeId;
      allow delete: if ownsTenant(storeId);
    }

    // Fallback — everything else requires platform admin
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
