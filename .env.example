# ── M&K Store — Required Environment Variables ──

# PostgreSQL connection string (provided by Northflank after creating DB)
DATABASE_URL=

# JWT signing secret (generate a long random string)
JWT_SECRET=

# Server port (Northflank sets PORT automatically; default 3001)
PORT=3001

# Node environment
NODE_ENV=production

# Frontend URL for CORS (same-origin: leave empty or set to deployment URL)
FRONTEND_URL=

# Frontend build-time variables (set during build, not runtime)
# VITE_API_URL=/api
# VITE_IMG_URL=
