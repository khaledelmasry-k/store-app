# ──────────────────────────────────────────────
# M&K Store — Required Environment Variables
# ──────────────────────────────────────────────

# --- Database ---
# PostgreSQL connection string (Render provides this automatically)
# Example: postgresql://user:pass@host:5432/mk_store
DATABASE_URL=

# --- Authentication ---
# JWT signing secret (use a long random string; Render can generate this)
JWT_SECRET=change-me-in-production

# --- CORS ---
# Frontend URL(s) for CORS. Comma-separated for multiple origins.
# In production (same-origin), this can be omitted or set to the Render URL.
# Example: https://my-custom-domain.com,https://mk-store-api.onrender.com
FRONTEND_URL=

# --- Server ---
# Server port (Render sets this automatically via PORT env var)
# Default: 3001
PORT=10000

# --- Frontend Build (set during build time, NOT runtime) ---
# API base URL for the frontend. Same-origin: "/api"
# Cross-origin: "https://api.example.com/api"
# VITE_API_URL=/api
#
# Image base URL. Same-origin: leave empty
# Cross-origin: "https://api.example.com"
# VITE_IMG_URL=
