# ─── Firebase config (public keys — safe to commit) ─────────────────────────
VITE_FIREBASE_API_KEY=AIzaSyEXAMPLE-placeholder
VITE_FIREBASE_AUTH_DOMAIN=mk-store-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mk-store-app
VITE_FIREBASE_STORAGE_BUCKET=mk-store-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:placeholder

# Firebase Emulator flag — set to "true" when running against local emulators
VITE_FIREBASE_USE_EMULATOR=false
